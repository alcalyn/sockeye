{
  "name": "sockeye",
  "version": "0.0.0",
  "private": true,
  "description": "Monitor WebSocket traffic of your server app: volume, payload size, bandwidth and response time per message type.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "clean": "rm -rf src/*/dist src/*/*.tsbuildinfo",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@changesets/cli": "^2.27.11"
  },
  "packageManager": "pnpm@10.33.0"
}
