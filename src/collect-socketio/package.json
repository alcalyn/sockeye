{
  "name": "@sockeye-js/collect-socketio",
  "version": "0.3.0",
  "description": "sockeye collector for socket.io: one middleware, and every event is measured.",
  "license": "AGPL-3.0-or-later",
  "author": "Julien Maulny (https://github.com/alcalyn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alcalyn/sockeye.git",
    "directory": "src/collect-socketio"
  },
  "homepage": "https://github.com/alcalyn/sockeye/tree/main/src/collect-socketio#readme",
  "bugs": "https://github.com/alcalyn/sockeye/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@sockeye-js/core": "workspace:^"
  },
  "peerDependencies": {
    "socket.io": ">=4"
  },
  "peerDependenciesMeta": {
    "socket.io": {
      "optional": true
    }
  },
  "devDependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "keywords": [
    "socket.io",
    "websocket",
    "monitoring",
    "metrics"
  ],
  "publishConfig": {
    "access": "public"
  }
}
