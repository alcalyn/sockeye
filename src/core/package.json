{
  "name": "@sockeye/core",
  "version": "0.1.0",
  "description": "Shared types, store interfaces and statistics primitives for sockeye.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup"
  },
  "keywords": [
    "websocket",
    "monitoring",
    "metrics",
    "socket.io"
  ],
  "publishConfig": {
    "access": "public"
  }
}
