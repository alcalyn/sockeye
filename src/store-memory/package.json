{
  "name": "@sockeye/store-memory",
  "version": "0.1.0",
  "description": "In-process store for sockeye: keeps WebSocket metrics in memory, with no external service.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@sockeye/core": "workspace:^"
  },
  "keywords": [
    "websocket",
    "monitoring",
    "metrics"
  ],
  "publishConfig": {
    "access": "public"
  }
}
