{
  "name": "@sockeye/ui",
  "version": "0.1.0",
  "description": "Local dashboard for sockeye: a REST API and a small Vue SPA you can mount on any server.",
  "license": "AGPL-3.0-or-later",
  "author": "Julien Maulny (https://github.com/alcalyn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alcalyn/sockeye.git",
    "directory": "src/ui"
  },
  "homepage": "https://github.com/alcalyn/sockeye/tree/main/src/ui#readme",
  "bugs": "https://github.com/alcalyn/sockeye/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.ts && tsup",
    "dev:client": "vite --config client/vite.config.ts"
  },
  "dependencies": {
    "@sockeye/core": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "keywords": [
    "websocket",
    "monitoring",
    "dashboard",
    "metrics"
  ],
  "publishConfig": {
    "access": "public"
  }
}
